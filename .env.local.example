# GadgetFlow — пример переменных окружения для локального запуска
# Скопируйте файл в .env.local и замените значения на реальные.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Для Server Actions / admin можно использовать сервисный ключ (Database → Roles → service_role)
# Храните его только на сервере и не публикуйте в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Базовая HTTP-авторизация для /admin
# В production обязательно замените admin / changeme
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Платёжный провайдер: demo | bePaid | webpay | assist | erip
PAYMENT_PROVIDER_ID=demo

# bePaid (опционально, при PAYMENT_PROVIDER_ID=bePaid)
BEPAID_ID=your-bepaid-id
BEPAID_SECRET=your-bepaid-secret
BEPAID_CHECKOUT_URL=https://checkout.bepaid.by

# WebPay (опционально, при PAYMENT_PROVIDER_ID=webpay)
WEBPAY_STORE_ID=your-webpay-store-id
WEBPAY_SECRET=your-webpay-secret-key
WEBPAY_API_URL=https://secureservice.webpay.by

# Assist Belarus (опционально, при PAYMENT_PROVIDER_ID=assist)
ASSIST_MERCHANT_ID=your-assist-merchant-id
ASSIST_SECRET=your-assist-secret

# ЕРИП (опционально, при PAYMENT_PROVIDER_ID=erip)
ERIP_SERVICE_CODE=your-erip-service-code
ERIP_API_URL=https://api.erip.by

# Секрет для проверки webhook-подписей (минимум 32 символа)
PAYMENT_WEBHOOK_SECRET=change-me-to-random-string-at-least-32-chars

# URL сайта (для ссылок в платёжках и webhook)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
